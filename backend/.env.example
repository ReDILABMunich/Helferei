# Copy to .env and fill in. .env is gitignored; this file is not.

# Required. The backend's own OpenAI key — every chat answer is billed to it.
OPENAI_API_KEY=

# Optional. Overrides the default model (gpt-4o-mini).
# OPENAI_MODEL=

# Optional. Shared secret the frontend must send as the X-API-Key header on
# /chat. Leave empty to disable the check (useful locally, and while the
# frontend has not shipped the header yet).
APP_API_KEY=
